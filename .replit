modules = ["nodejs-24", "python-3.12", "dotnet-10.0"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["cloudflared", "gitFull", "litterbox", "mailutils", "playwright-driver", "railway", "yt-dlp"]

[userenv]

[userenv.shared]
